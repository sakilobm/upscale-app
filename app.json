{
  "expo": {
    "name": "WhereCash",
    "slug": "WhereCash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/Icon-512x512.png",
    "userInterfaceStyle": "dark",
    "scheme": "wherecash",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wherecash.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF0",
        "foregroundImage": "./assets/app-icon/Icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/app-icon/Icon-Monochrome.png"
      },
      "package": "com.wherecash.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon/Icon-48x48.png"
    },
    "router": {
      "root": "src/app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow WhereCash to access Face ID for secure authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}